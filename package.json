    "models": "node scripts/download-models.mjs",
    "models:all": "node scripts/download-models.mjs --detector"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "framer-motion": "^12.38.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "mask",
    "ai",
    "segmentation",
    "sam2",
    "onnxruntime",
    "megashader",
    "react",
    "webgpu"
  ],
  "license": "UNLICENSED"
