# ── Build outputs ─────────────────────────────────────────────────────────────
# Generated by build.mjs (bun build). Re-run `bun build.mjs` to regenerate.
app.js
app.js.map
chunk-*.js
chunk-*.js.map

# ── ONNX Runtime WASM files ────────────────────────────────────────────────────
# Large (~77 MB total) runtime files for onnxruntime-web / @huggingface/transformers.
# ── Vendored runtime + weights (bun run models) ───────────────────────────────
# ~227 MB. Produced by scripts/download-models.mjs; never committed. Without
# them the app falls back to the pinned CDN on first use.
lib/ort-web/
models/
# Local, not shipped: it records THIS machine's file sizes and a timestamp, and
# nothing fetches it at runtime — download-models.mjs is its only reader (its
# idempotency check). Tracking it made every clone dirty after setup.
models/manifest.json

# Retired: the old transformers.js path pointed onnxruntime-web here.
ort/

# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules

# ── Large media / test assets ─────────────────────────────────────────────────
# The sample test image is large (7+ MB). Replace with a smaller one for the repo,
# or add your own test.png locally after cloning.
test.png

# Screen recordings and videos
*.mp4
*.mov
*.webm

# ── macOS system files ─────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor / IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Misc ───────────────────────────────────────────────────────────────────────
*.log

# bench corpus — ~200 MB of camera files, regenerate with bench/make-corpus.mjs
bench/corpus/
